IDI_FRACT01             ICON    DISCARDABLE     "fract01.ICO"
IDI_SMALL               ICON    DISCARDABLE     "SMALL.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_FRACT01 MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Random map",                  IDM_RANDMAP
        MENUITEM "Load map...",                 IDM_LOAD
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
        MENUITEM "",                            ID_FILE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
    POPUP "Oprions"
    BEGIN
        MENUITEM "Compute fractal dimension",   IDM_DIM
        MENUITEM "Matrix test...",              IDM_TEST
    END
END


/////////////////////////////////////////////////////////////////////////////

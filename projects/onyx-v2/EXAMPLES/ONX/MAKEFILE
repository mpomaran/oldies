compiler = WPP386
compOptions = /oneatx /oh /oi+ /ei /zp8 /5 /fp5 /d0
linkOptions =
objs = a0.obj
libs = ..\..\lib\onyx3d.lib

onx.exe: $(objs) makefile $(libs)
          wlink N onx.exe $(linkOptions) F {$(objs)} L {$(libs)} system pmodew
          del *.obj

.cpp.obj:
          $(compiler) $(compOptions) $*.cpp


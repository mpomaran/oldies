compOptions = /d3
linkOptions = debug all
objs = a0.obj
libs = ..\..\lib\onyx3d.lib

a0.exe: $(objs) makefile $(libs)
          wlink N a0.exe $(linkOptions) F {$(objs)} L {$(libs)}
          del *.obj

.cpp.obj:
          $(compiler) $(compOptions) $*.cpp


compiler = WPP386
compOptions = /oneatx /oh /oi+ /ei /zp8 /5 /fp5 /d0
linkOptions =
objs = a0.obj
libs = ..\..\lib\onyx3d.lib

a0.exe: $(objs) makefile $(libs)
          wlink N a0.exe $(linkOptions) F {$(objs)} L {$(libs)} @c:\eos\resource\eos.lnk system eos_c
          del *.obj

.cpp.obj:
          $(compiler) $(compOptions) $*.cpp

